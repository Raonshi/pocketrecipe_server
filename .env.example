# Local Docker Compose defaults only. Do not use these values in production.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pocketrecipe
SPRING_DATASOURCE_USERNAME=pocketrecipe
SPRING_DATASOURCE_PASSWORD=pocketrecipe
APP_SECURITY_ENFORCEMENT=false
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
FOOD_SAFETY_MOCK_ENABLED=true
FOOD_SAFETY_API_KEY=

# Production requires secret-store values, APP_SECURITY_ENFORCEMENT=true,
# APP_SECURITY_ALLOWED_ORIGINS, APP_SECURITY_JWT_ISSUER_URI, and
# APP_SECURITY_JWT_JWK_SET_URI. The database URL must use sslmode=verify-full.
